# Core images
POSTGRES_IMAGE=postgres:16-alpine
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8
TARANTOOL_IMAGE=tarantool/tarantool:2.11
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:latest
NGINX_IMAGE=nginx:1.27-alpine

# Core services
POSTGRES_USER=asfp
POSTGRES_PASSWORD=asfp123
POSTGRES_DB=asfp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# BACKUP_INTERVAL_SECONDS=3600
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=analytics123
TARANTOOL_USER_NAME=queue
TARANTOOL_USER_PASSWORD=queue123

# Shared connection strings
DATABASE_URL=postgres://asfp:asfp123@postgres:5432/asfp?sslmode=disable
MES_DATABASE_URL=postgres://asfp:asfp123@postgres:5432/asfp?sslmode=disable
MONTAGE_DATABASE_URL=postgres://asfp:asfp123@postgres:5432/asfp?sslmode=disable
DOCS_DATABASE_URL=postgres://asfp:asfp123@postgres:5432/asfp?sslmode=disable
BPM_DATABASE_URL=postgres://asfp:asfp123@postgres:5432/asfp?sslmode=disable

CLICKHOUSE_DSN=http://analytics:analytics123@clickhouse:8123/analytics

GATEWAY_TARANTOOL_ADDR=tarantool:3301
GATEWAY_TARANTOOL_QUEUE=queue.core
CRM_TARANTOOL_ADDR=tarantool:3301
CRM_TARANTOOL_QUEUE=queue.crm
ANALYTICS_TARANTOOL_ADDR=tarantool:3301
ANALYTICS_TARANTOOL_QUEUE=queue.analytics

# Object storage
S3_ACCESS_KEY=asfp-access
S3_SECRET_KEY=asfp-secret
S3_REGION=us-east-1
S3_BUCKET=asfp-demo
GATEWAY_S3_ENDPOINT=http://ceph:7480
GATEWAY_S3_REGION=us-east-1
GATEWAY_S3_USE_SSL=false

# Analytics API
ANALYTICS_HTTP_PORT=8090

# Service readiness probes
CRM_READY_URL=http://crm:8081/ready
WMS_READY_URL=http://wms:8082/ready
