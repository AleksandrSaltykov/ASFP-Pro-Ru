          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "sortOrder": {
            "type": "integer"
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CatalogNodeInput": {
